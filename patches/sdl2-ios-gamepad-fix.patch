index e968288..c4bada8 100644
--- a/src/joystick/SDL_joystick.c
+++ b/src/joystick/SDL_joystick.c
@@ -438,6 +438,19 @@ SDL_bool SDL_JoysticksQuitting(void)
     return SDL_joysticks_quitting;
 }
 
+SDL_bool SDL_JoysticksOpened(void)
+{
+    SDL_bool opened;
+
+    SDL_LockJoysticks();
+    {
+        opened = (SDL_joysticks != NULL) ? SDL_TRUE : SDL_FALSE;
+    }
+    SDL_UnlockJoysticks();
+
+    return opened;
+}
+
 void SDL_LockJoysticks(void)
 {
     (void)SDL_AtomicIncRef(&SDL_joystick_lock_pending);
